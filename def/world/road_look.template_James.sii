SiiNunit
{
# For modders: Please do not modify this file if you want to add a new entry. Create in
# this directory a new file "<base_name>.<idofyourmod>.sii" where <base_name> is name of
# base file without the extension (e.g. "city" for "/def/city.sii") and <idofyourmod> is
# some string which is unlikely to conflict with other mod.
#
# Warning: Even if the units are specified in more than one source file, they share the
# same namespace so suffixes or prefixes should be used to avoid conflicts.


#########################################################################

road_look : road.tfmger5
{
	name: "tfm ger road 1 one way"
	template_right: "/road_template/ger/ger_road_1_one_way.pmd"

	lanes_left[]: traffic_lane.road.local

	lane_offsets_left[]: (2.25, 0.0)


	compatible_edges_right[]: ger_sw_3m_a
	compatible_edges_right[]: ger_sw_3m_b
	compatible_edges_right[]: ger_sw_3m_c
	compatible_edges_right[]: ger_sw_3m_c1
	compatible_edges_right[]: ger_sw_3m_d
	compatible_edges_right[]: ger_sh_15
	compatible_edges_right[]: ger_curb_15
	compatible_edges_right[]: ger_sh_as_15

	shoulder_space_left: 0.5
	shoulder_space_right: 0.5

}

road_look : road.tfmger9
{
	name: "tfm ger road 2 narrow one way tmpl"
	template_right: "/road_template/ger/ger_road_2_1.pmd"

	add_parts_left[]: parking_at
	add_parts_left[]: parking_de

	lanes_left[]: traffic_lane.road.expressway
	lanes_left[]: traffic_lane.road.expressway

	lane_variant_default: expressway
	lane_variants[]: .lane_var.road.ger9.local
	lane_variants[]: .lane_var.road.ger9.motorway


	compatible_edges_right[]: ger_sw_3m_a
	compatible_edges_right[]: ger_sw_3m_b
	compatible_edges_right[]: ger_sw_3m_c
	compatible_edges_right[]: ger_sw_3m_c1
	compatible_edges_right[]: ger_sw_3m_d
	compatible_edges_right[]: ger_sh_15
	compatible_edges_right[]: ger_curb_15
	compatible_edges_right[]: ger_sh_as_15

	compatible_edges_left[]: ger_sw_3m_a
	compatible_edges_left[]: ger_sw_3m_b
	compatible_edges_left[]: ger_sw_3m_c
	compatible_edges_left[]: ger_sw_3m_c1
	compatible_edges_left[]: ger_sw_3m_d
	compatible_edges_left[]: ger_sh_15
	compatible_edges_left[]: ger_curb_15
	compatible_edges_left[]: ger_sh_as_15

	shoulder_space_left: 0.25
	shoulder_space_right: 0.25


}
	road_template_variant : .lane_var.road.ger9.local
	{
		lane_variant: local_road

		lanes_left[]: traffic_lane.road.local.high_density
		lanes_left[]: traffic_lane.road.local.high_density
	}

	road_template_variant : .lane_var.road.ger9.motorway
	{
		lane_variant: motorway

		lanes_left[]: traffic_lane.road.motorway
		lanes_left[]: traffic_lane.road.motorway
	}
}
